	column risk_band
		dataType: string
		lineageTag: f8d6a698-b0ae-4cf1-a1ce-b9bc6a0c2b72
		summarizeBy: none
		sourceColumn: risk_band

		annotation SummarizationSetBy = Automatic

	measure 'Transactions' =
			COUNTROWS ( fact_transaction )
		formatString: #,0
		lineageTag: 95a99461-9635-42a7-9890-7a9901d3cb00

	measure 'Total Amount' =
			SUM ( fact_transaction[txn_amount] )
		formatString: "RM "#,0.00
		lineageTag: 7f9ad41b-8e3f-4b7d-8479-ad70efe7248c

	measure 'Distinct Customers' =
			DISTINCTCOUNT ( fact_transaction[customer_key] )
		formatString: #,0
		lineageTag: 22a6d5ed-f840-4cf2-9af5-01b1fbc2c5d6

	measure 'Average Risk Score' =
			AVERAGE ( fact_transaction[risk_score] )
		formatString: #,0.0
		lineageTag: 8acbb41c-0eae-4f50-a819-0402dc4d9e86

	measure 'High Risk Transactions' =
			CALCULATE ( [Transactions], fact_transaction[risk_band] = "HIGH" )
		formatString: #,0
		lineageTag: 23899e14-4f65-4b81-9301-0bf83e27919a

	measure 'High Risk Rate' =
			DIVIDE ( [High Risk Transactions], [Transactions] )
		formatString: 0.00%
		lineageTag: ed873cd8-6d72-4cea-8af9-3b7ff93bf612

	measure 'Exposure at Risk' =
			CALCULATE ( [Total Amount], fact_transaction[risk_band] = "HIGH" )
		formatString: "RM "#,0
		lineageTag: 7bd025c2-f614-4002-9028-ebd8a5776b1f

	measure 'Approval Rate' =
			DIVIDE ( CALCULATE ( [Transactions], fact_transaction[auth_approved] = TRUE () ), CALCULATE ( [Transactions], NOT ISBLANK ( fact_transaction[auth_approved] ) ) )
		formatString: 0.0%
		lineageTag: fd803617-ada1-4cc8-88cc-2037a621cd4e

	measure 'Cross Border Amount' =
			CALCULATE ( [Total Amount], fact_transaction[txn_currency] <> "MYR" )
		formatString: "RM "#,0
		lineageTag: 49954222-de4c-4e2d-bf86-b864fc15faf9

	measure 'Alerts Raised' =
			CALCULATE ( [Transactions], fact_transaction[risk_band] = "HIGH" )
		formatString: #,0
		lineageTag: d8e5ae5e-b90b-4909-bede-0e4043028527

	measure 'Alert Rate' =
			DIVIDE ( [Alerts Raised], [Transactions] )
		formatString: 0.00%
		lineageTag: 1639e745-4121-44a7-8da1-22382f3973d0

	measure 'Analyst Years to Clear' =
			DIVIDE ( [Alerts Raised], 50000 )
		formatString: #,0.0
		lineageTag: 8e04e8f6-5f56-4da3-ab93-94be6651a6da

	partition fact_transaction = entity
		mode: directLake
		source
			entityName: gold_fact_transaction
			expressionSource: DatabaseQuery

	annotation PBI_ResultType = Table

