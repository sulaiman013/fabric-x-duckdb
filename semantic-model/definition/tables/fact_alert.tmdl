table fact_alert
	lineageTag: c90193d2-1e55-4941-93c5-a41ffe379410

	column _mirror_row_id
		dataType: int64
		isHidden
		lineageTag: 99b29ccb-1774-49f3-88d2-3069c0fbab76
		summarizeBy: none
		sourceColumn: _mirror_row_id

		annotation SummarizationSetBy = Automatic

	column rule_id
		dataType: string
		lineageTag: cbe27abd-2de7-46e9-abbe-90842358ed0a
		summarizeBy: none
		sourceColumn: rule_id

		annotation SummarizationSetBy = Automatic

	column weight
		dataType: int64
		formatString: #,0
		lineageTag: 182f4c6c-2107-4358-9d4d-30daf233c1e5
		summarizeBy: sum
		sourceColumn: weight

		annotation SummarizationSetBy = Automatic

	measure 'Alerts' =
			COUNTROWS ( fact_alert )
		formatString: #,0
		lineageTag: 948efcf6-4522-4cc6-8633-2848125ea162

	measure 'Alerts per Transaction' =
			DIVIDE ( [Alerts], [Transactions] )
		formatString: #,0.00
		lineageTag: 3797e3d6-e0a6-43e1-8bb4-e7fa03318d08

	measure 'Transactions Alerted' =
			DISTINCTCOUNT ( fact_alert[_mirror_row_id] )
		formatString: #,0
		lineageTag: eca25503-e117-4425-828e-648f57d19d5b

	measure 'Alert Fire Rate' =
			DIVIDE ( [Transactions Alerted], [Transactions] )
		formatString: 0.0%
		lineageTag: 44dafd0b-f703-4117-86cc-0071e2425e71

	partition fact_alert = entity
		mode: directLake
		source
			entityName: gold_fact_alert
			expressionSource: DatabaseQuery

	annotation PBI_ResultType = Table

