<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1" />
  <PropertyGroup>
    <AllowSnapshotIsolation>True</AllowSnapshotIsolation>
    <AutoCreateStatistics>True</AutoCreateStatistics>
    <AutoUpdateStatistics>True</AutoUpdateStatistics>
    <CatalogCollation>SQL_Latin1_General_CP1_CI_AS</CatalogCollation>
    <ChangeTrackingAutoCleanup>False</ChangeTrackingAutoCleanup>
    <CursorCloseOnCommit>False</CursorCloseOnCommit>
    <DbScopedConfigMaxDOP>8</DbScopedConfigMaxDOP>
    <DefaultCursor>GLOBAL</DefaultCursor>
    <DefaultFilegroup>PRIMARY</DefaultFilegroup>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlDbFabricDatabaseSchemaProvider</DSP>
    <FileStreamDirectoryName></FileStreamDirectoryName>
    <IsQueryStoreOn>True</IsQueryStoreOn>
    <ModelCollation>1033, CI</ModelCollation>
    <Name>fincrime_ops-446f966e-7df5-4284-a279-fdb32ef3b8a1</Name>
    <PageVerify>CHECKSUM</PageVerify>
    <ProjectGuid>{00000000-0000-0000-0000-000000000000}</ProjectGuid>
    <QueryStoreCaptureMode>AUTO</QueryStoreCaptureMode>
    <QueryStoreMaxPlansPerQuery>200</QueryStoreMaxPlansPerQuery>
    <QueryStoreMaxStorageSizeMB>100</QueryStoreMaxStorageSizeMB>
    <QueryStoreStaleQueryThreshold>30</QueryStoreStaleQueryThreshold>
    <QueryStoreStaleQueryThresholdDays>30</QueryStoreStaleQueryThresholdDays>
    <ReadCommittedSnapshot>True</ReadCommittedSnapshot>
    <RecursiveTriggers>False</RecursiveTriggers>
    <ServiceBrokerOption>EnableBroker</ServiceBrokerOption>
    <TargetRecoveryTimePeriod>60</TargetRecoveryTimePeriod>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.DbFabric">
      <SuppressMissingDependenciesErrors>False</SuppressMissingDependenciesErrors>
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
      <Version>170.0.0</Version>
    </PackageReference>
  </ItemGroup>
  <Target Name="BeforeBuild">
    <Delete Files="$(BaseIntermediateOutputPath)\project.assets.json" />
  </Target>
</Project>